<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and older (SPEC.md BAK-4): these versions can't tell cloud
     backup from device transfer, so both are excluded to keep data off
     Google's servers. Users move data with the app's backup file instead. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
